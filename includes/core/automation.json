{
    "description_convention": {
        "label": "Portflow Port Description Convention",
        "template": "PF|{{portflow_id}}|{{connection_ref}}|{{patchfield}}",
        "notes": [
        "Use a stable identifier that can be searched from Portflow.",
        "Keep the prefix fixed so descriptions remain machine-readable.",
        "Avoid free-text notes before the structured fields."
        ]
    },
    "profiles": {
        "huawei_core_commit": {
            "label": "Huawei Core",
            "description": "Core switches use commit and save after configuration changes.",
            "snmp": {
                "extension": "huawei"
            },
            "supports_commit": true,
            "enter_config": "system-view",
            "commit": "commit",
            "save": "save",
            "write_config": "Y",
            "exit_config": "return"
        },
        "huawei_access_no_commit": {
            "label": "Huawei Access",
            "description": "Access switches apply configuration directly without a commit step.",
            "snmp": {
                "extension": "huawei",
                "node_ip_collection": "cli-dhcp-snooping",
                "poe_collection": "cli"
            },
            "supports_commit": false,
            "enter_config": "system-view",
            "commit": "",
            "save": "save",
            "write_config": "Y",
            "exit_config": "return"
        },
        "ubiquiti_unifi": {
            "label": "Ubiquiti UniFi",
            "description": "UniFi switches use a controller-based approach and do not support CLI configuration changes via SSH.",
            "snmp": {
                "extension": "ubiquiti_unifi"
            },
            "supports_commit": false,
            "enter_config": "",
            "commit": "",
            "save": "",
            "write_config": "",
            "exit_config": ""
        }
    },
    "templates": {
        "set_port_description": {
        "label": "Set Port Description",
        "description": "Writes a Portflow reference into the switch port description.",
        "supported_profiles": ["huawei_core_commit", "huawei_access_no_commit"],
        "uses_description_convention": true,
        "variables": [
            { "name": "interface", "label": "Interface", "type": "text", "required": true, "placeholder": "GigabitEthernet1/0/1" },
            { "name": "portflow_id", "label": "Portflow ID", "type": "text", "required": true, "placeholder": "PF-000123" },
            { "name": "connection_ref", "label": "Connection Reference", "type": "text", "required": false, "placeholder": "Patchfield A / Port 12" },
            { "name": "patchfield", "label": "Patchfield / Room", "type": "text", "required": false, "placeholder": "Room 2.15" },
            { "name": "description", "label": "Description Override", "type": "text", "required": false, "placeholder": "Optional custom description" }
        ],
        "commands": [
            "interface {{interface}}",
            "description {{description}}",
            "quit"
        ]
        },
        "set_port_vlan": {
        "label": "Set Port VLAN",
        "description": "Assigns one VLAN to a switch port.",
        "supported_profiles": ["huawei_core_commit", "huawei_access_no_commit"],
        "variables": [
            { "name": "interface", "label": "Interface", "type": "text", "required": true, "placeholder": "GigabitEthernet1/0/1" },
            { "name": "vlan_id", "label": "VLAN ID", "type": "number", "required": true, "placeholder": "120" }
        ],
        "commands": [
            "interface {{interface}}",
            "undo shutdown",
            "port link-type access",
            "port default vlan {{vlan_id}}",
            "loopback-detect enable",
            "loopback-detect action error-down",
            "loopback-detect vlan {{vlan_id}}",
            "dhcp snooping enable",
            "quit"
        ]
        },
        "shutdown_port": {
        "label": "Shutdown Port",
        "description": "Disables a switch port.",
        "supported_profiles": ["huawei_core_commit", "huawei_access_no_commit"],
        "variables": [
            { "name": "interface", "label": "Interface", "type": "text", "required": true, "placeholder": "GigabitEthernet1/0/1" }
        ],
        "commands": [
            "interface {{interface}}",
            "shutdown",
            "quit"
        ]
        },
        "no_shutdown_port": {
        "label": "No Shutdown Port",
        "description": "Enables a switch port (undo shutdown).",
        "supported_profiles": ["huawei_core_commit", "huawei_access_no_commit"],
        "variables": [
            { "name": "interface", "label": "Interface", "type": "text", "required": true, "placeholder": "GigabitEthernet1/0/1" }
        ],
        "commands": [
            "interface {{interface}}",
            "undo shutdown",
            "quit"
        ]
        },
        "set_port_pvid": {
        "label": "Set Port PVID",
        "description": "Assigns the access (untagged) VLAN PVID to a switch port.",
        "supported_profiles": ["huawei_core_commit", "huawei_access_no_commit"],
        "variables": [
            { "name": "interface", "label": "Interface", "type": "text", "required": true, "placeholder": "GigabitEthernet1/0/1" },
            { "name": "vlan_id", "label": "VLAN ID", "type": "number", "required": true, "placeholder": "120" }
        ],
        "commands": [
            "interface {{interface}}",
            "port link-type access",
            "port default vlan {{vlan_id}}",
            "quit"
        ]
        },
        "set_trunk_allowed_vlans": {
        "label": "Set Trunk Allowed VLANs",
        "description": "Configures a trunk port and replaces the allowed VLAN list.",
        "supported_profiles": ["huawei_core_commit", "huawei_access_no_commit"],
        "variables": [
            { "name": "interface", "label": "Interface", "type": "text", "required": true, "placeholder": "GigabitEthernet1/0/1" },
            { "name": "allowed_vlans", "label": "Allowed VLAN List", "type": "text", "required": true, "placeholder": "10 20 30 to 40" },
            { "name": "pvid", "label": "Native VLAN (PVID)", "type": "number", "required": false, "placeholder": "1" }
        ],
        "commands": [
            "interface {{interface}}",
            "port link-type trunk",
            "undo port trunk allow-pass vlan all",
            "port trunk allow-pass vlan {{allowed_vlans}}",
            "port trunk pvid vlan {{pvid}}",
            "quit"
        ]
        },
        "cleanup_port": {
        "label": "Cleanup Port",
        "description": "Cleans up a switch port.",
        "supported_profiles": ["huawei_core_commit", "huawei_access_no_commit"],
        "variables": [
            { "name": "interface", "label": "Interface", "type": "text", "required": true, "placeholder": "GigabitEthernet1/0/1" }
        ],
        "commands": [
            "interface {{interface}}",
            "shutdown",
            "undo port link-type",
            "undo port default vlan",
            "undo dhcp snooping enable",
            "undo description",
            "undo loopback-detect enable",
            "quit"
        ]
        }
    }
}