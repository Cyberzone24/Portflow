RewriteEngine On

# Block direct access to secrets and application data in Apache deployments.
RewriteRule ^(?:data/|\.env(?:\..*)?|\.git|composer\.(?:json|lock)|Dockerfile$|podman-compose\.yml$) - [F,L,NC]

# Forward the HTTP Authorization header to PHP in Apache setups.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1