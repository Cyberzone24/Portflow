RewriteEngine On

# Block direct access to secrets and application data in Apache deployments.
<IfModule mod_authz_core.c>
	<If "%{REQUEST_URI} =~ m#^/(?:data(?:/.*)?|\.git(?:/.*)?|\.env(?:\..*)?|\.htaccess|\.gitignore|\.gitmodules|composer\.(?:json|lock)|Dockerfile|podman-compose\.yml)$#i">
		Require all denied
	</If>
</IfModule>

RewriteRule ^(?:data(?:/.*)?|\.git(?:/.*)?|\.env(?:\..*)?|\.htaccess|\.gitignore|\.gitmodules|composer\.(?:json|lock)|Dockerfile|podman-compose\.yml)$ - [F,L,NC]

# Forward the HTTP Authorization header to PHP in Apache setups.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1