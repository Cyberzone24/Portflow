# Logging
LOG_LEVEL=1

# Database Configuration
DB_TYPE=pgsql
DB_SERVER=localhost
DB_PORT=5432
DB_NAME=port_dev
DB_USER=portflow
DB_PASSWORD=portflow

# Portflow Server Settings
PORTFLOW_HOSTNAME=http://localhost/Portflow-DEV
PORTFLOW_SECURE=false
PORTFLOW_REGISTER=true
PORTFLOW_FIRST_RUN=false

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_USER=user@example.com
MAIL_PASSWORD=password
MAIL_PORT=587
MAIL_SMTPAUTH=true
MAIL_SMTPSECURE=tls

# LDAP Configuration (Optional)
LDAP_ENABLED=false
LDAP_SERVER=ldap.example.com
LDAP_PORT=389
LDAP_BASEDN=dc=example,dc=com
LDAP_USERDN=ou=people
LDAP_FILTER=(uid=*)
LDAP_BIND=false
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_TRUST=true

# Notification Settings
NOTIFICATION_DAILY_TIME=08:00
NOTIFICATION_TIMEZONE=Europe/Berlin

# Automation Encryption Secret
AUTOMATION_SECRET=change-this-to-a-long-random-value
