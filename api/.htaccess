RewriteEngine On

# Forward the HTTP Authorization header to PHP. Apache + php-fpm/cgi strips it
# by default, which breaks HTTP Basic auth used by the Portflow CLI tool.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Stellt sicher, dass Anfragen an Dateien oder Verzeichnisse direkt bedient werden
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Leitet alle anderen Anfragen an die index.php Datei weiter
RewriteRule ^(.*)$ index.php [QSA,L]
